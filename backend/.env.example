# Enterprise Knowledge Engine Environment Configuration

# Server Settings
PROJECT_NAME="Enterprise Knowledge Engine"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# LLM & Embedding Settings
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
DEFAULT_LLM_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL="models/embedding-001"

# Vector DB & Storage Paths
CHROMA_PERSIST_DIR="./storage/vector_db"
UPLOAD_DIR="./storage/uploads"
DATABASE_URL="sqlite+aiosqlite:///./storage/app.db"

# RAG Defaults
DEFAULT_CHUNK_SIZE=768
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=4
